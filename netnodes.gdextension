[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://rust/target/debug/libnetnodes.so"
linux.release.x86_64 =   "res://rust/target/release/libnetnodes.so"
windows.debug.x86_64 =   "res://rust/target/debug/netnodes.dll"
windows.release.x86_64 = "res://rust/target/release/netnodes.dll"

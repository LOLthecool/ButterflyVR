[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://rust/target/debug/libgodot_lru_rust.so"
linux.release.x86_64 =   "res://rust/target/release/libgodot_lru_rust.so"
windows.debug.x86_64 =   "res://rust/target/debug/godot_lru_rust.dll"
windows.release.x86_64 = "res://rust/target/release/godot_lru_rust.dll"

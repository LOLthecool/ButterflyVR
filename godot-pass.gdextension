[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://rust/godot-pass/target/release/libgodot_pass.so"
linux.release.x86_64 =   "res://rust/godot-pass/target/release/libgodot_pass.so"
windows.debug.x86_64 =   "res://rust/godot-pass/target/release/godot_pass.dll"
windows.release.x86_64 = "res://rust/godot-pass/target/release/godot_pass.dll"

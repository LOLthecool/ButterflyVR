[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://rust/target/debug/libgodot_pass.so"
linux.release.x86_64 =   "res://rust/target/release/libgodot_pass.so"
windows.debug.x86_64 =   "res://rust/target/x86_64-pc-windows-gnu/debug/godot_pass.dll"
windows.release.x86_64 = "res://rust/target/x86_64-pc-windows-gnu/release/godot_pass.dll"

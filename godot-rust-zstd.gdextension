[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://rust/target/debug/libgodot_rust_zstd.so"
linux.release.x86_64 =   "res://rust/target/release/libgodot_rust_zstd.so"
windows.debug.x86_64 =   "res://rust/target/debug/godot_rust_zstd.dll"
windows.release.x86_64 = "res://rust/target/release/godot_rust_zstd.dll"
